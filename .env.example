# SERVER-ONLY: Gemini API key. Used by `app/api/ai/analyze/route.ts`.
# DO NOT prefix with NEXT_PUBLIC_ — that would leak the key into the browser bundle.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Optional model override for the AI proxy (defaults to gemini-2.5-flash).
# GEMINI_MODEL="gemini-2.5-flash"

# Public base URL of the backend API. Leave unset to run the demo against
# the built-in mock data; set it to e.g. https://api.example.com once the
# backend is ready. The frontend fetcher prepends this to all /api/v1/* calls.
NEXT_PUBLIC_API_BASE_URL=""

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
